{
	"name": "axis-crm",
	"version": "0.1.0",
	"description": "Assistente comercial conversacional para WhatsApp",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"mongo:start": "docker start mongodb 2>/dev/null || docker run -d --name mongodb -p 27017:27017 -e MONGO_INITDB_ROOT_USERNAME=admin -e MONGO_INITDB_ROOT_PASSWORD=admin mongo:7",
		"dev": "pnpm mongo:start && tsx watch --env-file=.env src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src tests",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
		"test": "vitest run --exclude '**/tests/integration/google-*.runtime.test.ts'",
		"test:integration:google": "vitest run tests/integration/google-calendar.runtime.test.ts tests/integration/google-sheets.runtime.test.ts",
		"perf:groq": "tsx --env-file=.env scripts/perf-groq.ts",
		"auth:create-user": "tsx --env-file=.env scripts/create-user.ts",
		"tenancy:backfill": "tsx --env-file=.env scripts/backfill-tenancy.ts"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^17.2.1",
		"express": "^5.1.0",
		"googleapis": "^176.0.0",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^8.16.0",
		"pino": "^9.7.0",
		"pino-http": "^10.4.0",
		"qrcode-terminal": "^0.12.0",
		"whatsapp-web.js": "^1.34.7",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/js-yaml": "^4.0.9",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.0.0",
		"@types/supertest": "^6.0.3",
		"eslint": "^9.30.0",
		"eslint-config-prettier": "^10.1.5",
		"js-yaml": "^5.4.1",
		"mongodb-memory-server": "^11.2.0",
		"prettier": "^3.6.0",
		"supertest": "^7.1.0",
		"tsx": "^4.20.0",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.35.0",
		"vitest": "^3.2.0"
	}
}
