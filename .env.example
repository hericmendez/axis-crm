NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://admin:admin@localhost:27017/crm-whatsapp?authSource=admin
LOG_LEVEL=info

# Autenticação da API (obrigatório em produção; vazio em dev/teste desabilita)
API_KEY=

# LLM: groq | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
WHATSAPP_SESSION_PATH=.wwebjs_auth
WHATSAPP_ENABLED=false
# IDs de grupo autorizados separados por vírgula (vazio = todos)
WHATSAPP_ALLOWED_GROUPS=
# Número do próprio Axis (para detectar menções)
AXIS_NUMBER=
# LID do próprio Axis (menções chegam como @lid; dígitos não derivam do número).
# Descubra enviando uma menção real ao Axis e lendo os logs do adapter.
WHATSAPP_SELF_LID=

GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Google OAuth 2.0 (per-user)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
