NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://admin:admin@localhost:27017/crm-whatsapp?authSource=admin
LOG_LEVEL=info

# Autenticação da API (obrigatório em produção; vazio em dev/teste desabilita)
API_KEY=

# LLM: groq | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
WHATSAPP_SESSION_PATH=.wwebjs_auth

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
